{
  "enabledMcpjsonServers": ["playwright"],
  "permissions": {
    "allow": [
      "Edit(/**)",
      "Write(/**)",
      "Bash(npm run test)",
      "Bash(npm run test:e2e)",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(npx prisma *)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/stop.js"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "FILE=$(cat | jq -r '.tool_input.file_path // empty') && [ -n \"$FILE\" ] && cd /Users/art/Documents/projects/video-meetings && npx prettier --write \"$FILE\" 2>/dev/null || true",
            "statusMessage": "Formatting file..."
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "FILE=$(cat | jq -r '.tool_input.file_path // empty') && [ -n \"$FILE\" ] && cd /Users/art/Documents/projects/video-meetings && npx prettier --write \"$FILE\" 2>/dev/null || true",
            "statusMessage": "Formatting file..."
          }
        ]
      }
    ]
  }
}
