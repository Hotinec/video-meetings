generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         Int       @id @default(autoincrement())
  email      String    @unique
  /// Case-insensitive (citext): "Alice" and "alice" collide.
  username   String    @unique @db.Citext
  password   String
  /// Path of the avatar file relative to UPLOAD_DIR; null when the user has no avatar.
  avatarPath String?
  meetings   Meeting[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Meeting {
  id        Int           @id @default(autoincrement())
  title     String
  date      DateTime
  host      User          @relation(fields: [hostId], references: [id])
  hostId    Int
  files     MeetingFile[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model MeetingFile {
  id           String   @id @default(uuid())
  meeting      Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  meetingId    Int
  originalName String
  mimeType     String
  size         Int
  filePath     String
  uploadedAt   DateTime @default(now())

  @@index([meetingId])
}
