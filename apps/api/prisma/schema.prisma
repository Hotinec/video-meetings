generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  password  String
  meetings  Meeting[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Meeting {
  id        Int      @id @default(autoincrement())
  title     String
  date      DateTime
  host      User     @relation(fields: [hostId], references: [id])
  hostId    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
